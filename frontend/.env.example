# Only needed when the frontend and backend are on different hosts —
# e.g. two separate ngrok tunnels, or a real deployment.
# Leave this file un-copied for normal local/LAN use; the app auto-detects
# the backend at that point (see src/config.js).
#
# To use it: copy this to ".env" and set the value to your backend's
# actual public URL (no trailing slash, no "/api" at the end).
VITE_API_URL=https://your-backend-tunnel-url.ngrok-free.app
